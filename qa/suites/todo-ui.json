{
  "_about": "TAH-5 todo UI: add/complete/delete/filter/clear-completed, inline edit, dismissible errors. Seeds and backend-effect checks go through the app's own REST API (api op); the app has no auth or /test seam. Element names follow the landed UI: error banner is role=alert with a 'Dismiss error' button; edit input is 'Edit title for <title>'; checkbox is 'Mark \"<title>\" as completed'; delete is 'Delete \"<title>\"'; the items-left count is the #count span, targeted by its 'left' text.",
  "schema_version": "1.0.0",
  "run_id": "todo-ui",
  "config": {
    "base_url": "http://localhost:3000",
    "parallelism": 1,
    "video": "fail",
    "default_timeout_ms": 15000
  },
  "namespace": {
    "run_id": "todo-ui",
    "email": "qa+todo-ui@example.com",
    "tag": "QA RUN todo-ui"
  },
  "scenarios": [
    {
      "name": "Add a todo through the form: listed in the UI and persisted",
      "tags": [
        "happy-path",
        "add"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open the todo app",
          "url": "/"
        },
        {
          "kind": "action",
          "op": "fill",
          "intent": "type a run-tagged title",
          "target": {
            "by": "placeholder",
            "name": "What needs to be done?"
          },
          "value": "Add {{run_id}}-add"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "submit the form",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Add",
            "exact": true
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the new todo appears in the list",
          "expected": {
            "kind": "text_present",
            "text": "Add {{run_id}}-add"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "exactly one row of ours is rendered",
          "expected": {
            "kind": "owned_count",
            "owned_tag": "{{run_id}}-add",
            "count": 1
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "read back the server list",
          "method": "GET",
          "api_path": "/api/todos?filter=all",
          "status": 200,
          "capture": {
            "all_todos": "$"
          }
        },
        {
          "kind": "action",
          "op": "transform",
          "intent": "find our persisted todo's title",
          "from_capture": "all_todos",
          "expr": "[.[] | select(.title | startswith(\"Add \")) | .title] | length > 0",
          "capture": {
            "has_add": "$"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the server holds an Add todo",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "has_add",
            "value": "true"
          }
        },
        {
          "kind": "action",
          "op": "transform",
          "intent": "find our persisted todo's id",
          "from_capture": "all_todos",
          "expr": "[.[] | select(.title == \"Add {{run_id}}-add\") | .id][0]",
          "capture": {
            "aid": "$"
          }
        }
      ],
      "teardown": [
        {
          "kind": "action",
          "op": "api",
          "intent": "clean up aid",
          "method": "DELETE",
          "api_path": "/api/todos/{{aid}}",
          "status": 204
        }
      ]
    },
    {
      "name": "Complete a todo: server flag set, Active/Completed filters split ours correctly",
      "tags": [
        "happy-path",
        "complete",
        "filter"
      ],
      "setup": [
        {
          "kind": "action",
          "op": "api",
          "intent": "seed 'Complete {{run_id}}-cmp'",
          "method": "POST",
          "api_path": "/api/todos",
          "body": {
            "title": "Complete {{run_id}}-cmp"
          },
          "status": 201,
          "capture": {
            "tid": "$.id"
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "seed 'Stay {{run_id}}-cmp'",
          "method": "POST",
          "api_path": "/api/todos",
          "body": {
            "title": "Stay {{run_id}}-cmp"
          },
          "status": 201,
          "capture": {
            "sid": "$.id"
          }
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open the todo app",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "both seeded todos are listed",
          "expected": {
            "kind": "text_present",
            "text": "Complete {{run_id}}-cmp"
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "tick our todo",
          "target": {
            "by": "role",
            "role": "checkbox",
            "name": "Mark \"Complete {{run_id}}-cmp\" as completed"
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "backend effect: completed on the server",
          "method": "GET",
          "api_path": "/api/todos/{{tid}}",
          "status": 200,
          "capture": {
            "done": "$.completed"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "server recorded completed=true",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "done",
            "value": "true"
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "the other todo is untouched",
          "method": "GET",
          "api_path": "/api/todos/{{sid}}",
          "status": 200,
          "capture": {
            "done2": "$.completed"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "other todo still active",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "done2",
            "value": "false"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "items-left counter is rendered",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "left"
            }
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "open Active filter",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Active",
            "exact": true
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "untouched todo is in Active",
          "expected": {
            "kind": "text_present",
            "text": "Stay {{run_id}}-cmp"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "one of ours in Active",
          "expected": {
            "kind": "owned_count",
            "owned_tag": "{{run_id}}-cmp",
            "count": 1
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "open Completed filter",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Completed",
            "exact": true
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "completed todo is in Completed",
          "expected": {
            "kind": "text_present",
            "text": "Complete {{run_id}}-cmp"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "one of ours in Completed",
          "expected": {
            "kind": "owned_count",
            "owned_tag": "{{run_id}}-cmp",
            "count": 1
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "back to All",
          "target": {
            "by": "role",
            "role": "button",
            "name": "All",
            "exact": true
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "both of ours in All",
          "expected": {
            "kind": "owned_count",
            "owned_tag": "{{run_id}}-cmp",
            "count": 2
          }
        }
      ],
      "teardown": [
        {
          "kind": "action",
          "op": "api",
          "intent": "clean up tid",
          "method": "DELETE",
          "api_path": "/api/todos/{{tid}}",
          "status": 204
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "clean up sid",
          "method": "DELETE",
          "api_path": "/api/todos/{{sid}}",
          "status": 204
        }
      ]
    },
    {
      "name": "Delete a todo: row disappears and the server forgets it",
      "tags": [
        "happy-path",
        "delete"
      ],
      "setup": [
        {
          "kind": "action",
          "op": "api",
          "intent": "seed 'Keep {{run_id}}-del'",
          "method": "POST",
          "api_path": "/api/todos",
          "body": {
            "title": "Keep {{run_id}}-del"
          },
          "status": 201,
          "capture": {
            "kid": "$.id"
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "seed 'Drop {{run_id}}-del'",
          "method": "POST",
          "api_path": "/api/todos",
          "body": {
            "title": "Drop {{run_id}}-del"
          },
          "status": 201,
          "capture": {
            "did": "$.id"
          }
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open the todo app",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "seeded todo is listed",
          "expected": {
            "kind": "text_present",
            "text": "Drop {{run_id}}-del"
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "delete our todo",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Delete \"Drop {{run_id}}-del\""
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "only the kept todo remains",
          "expected": {
            "kind": "owned_count",
            "owned_tag": "{{run_id}}-del",
            "count": 1
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "kept todo still shown",
          "expected": {
            "kind": "text_present",
            "text": "Keep {{run_id}}-del"
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "backend effect: deleted todo 404s",
          "method": "GET",
          "api_path": "/api/todos/{{did}}",
          "status": 404
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "kept todo survives",
          "method": "GET",
          "api_path": "/api/todos/{{kid}}",
          "status": 200,
          "capture": {
            "t": "$.title"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "kept todo untouched",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "t",
            "value": "Keep {{run_id}}-del"
          }
        }
      ],
      "teardown": [
        {
          "kind": "action",
          "op": "api",
          "intent": "clean up kid",
          "method": "DELETE",
          "api_path": "/api/todos/{{kid}}",
          "status": 204
        }
      ]
    },
    {
      "name": "Clear completed removes only completed todos",
      "tags": [
        "happy-path",
        "clear-completed"
      ],
      "setup": [
        {
          "kind": "action",
          "op": "api",
          "intent": "seed 'Done {{run_id}}-clr'",
          "method": "POST",
          "api_path": "/api/todos",
