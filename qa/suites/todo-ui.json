    {
      "name": "AC-1: a failed action shows a dismissible error and the list stays intact",
      "tags": [
        "ac-1",
        "error-state"
      ],
      "setup": [
        {
          "kind": "action",
          "op": "api",
          "intent": "seed 'Survivor {{run_id}}-err'",
          "method": "POST",
          "api_path": "/api/todos",
          "body": {
            "title": "Survivor {{run_id}}-err"
          },
          "status": 201,
          "capture": {
            "sid": "$.id"
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "seed 'Ghost {{run_id}}-err'",
          "method": "POST",
          "api_path": "/api/todos",
          "body": {
            "title": "Ghost {{run_id}}-err"
          },
          "status": 201,
          "capture": {
            "gid": "$.id"
          }
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open the todo app",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "both todos rendered before the failure",
          "expected": {
            "kind": "text_present",
            "text": "Ghost {{run_id}}-err"
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "delete Ghost behind the UI's back so the next UI action fails with 404",
          "method": "DELETE",
          "api_path": "/api/todos/{{gid}}",
          "status": 204
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "delete the now-stale Ghost row",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Delete \"Ghost {{run_id}}-err\""
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "an error is shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "alert"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the unrelated todo is still listed",
          "expected": {
            "kind": "text_present",
            "text": "Survivor {{run_id}}-err"
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "backend effect: survivor still on the server",
          "method": "GET",
          "api_path": "/api/todos/{{sid}}",
          "status": 200,
          "capture": {
            "t": "$.title"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "survivor intact",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "t",
            "value": "Survivor {{run_id}}-err"
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "dismiss the error",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Dismiss error"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the error is gone",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "role",
              "role": "alert"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "list still intact after dismissal",
          "expected": {
            "kind": "text_present",
            "text": "Survivor {{run_id}}-err"
          }
        }
      ],
      "teardown": [
        {
          "kind": "action",
          "op": "api",
          "intent": "clean up sid",
          "method": "DELETE",
          "api_path": "/api/todos/{{sid}}",
          "status": 204
        }
      ]
    }
  ]
}
