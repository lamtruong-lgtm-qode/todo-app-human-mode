        {
          "kind": "action",
          "op": "api",
          "intent": "seed 'Open {{run_id}}-clr'",
          "method": "POST",
          "api_path": "/api/todos",
          "body": {
            "title": "Open {{run_id}}-clr"
          },
          "status": 201,
          "capture": {
            "oid": "$.id"
          }
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open the todo app",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "both of ours listed",
          "expected": {
            "kind": "owned_count",
            "owned_tag": "{{run_id}}-clr",
            "count": 2
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "click Clear completed",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Clear completed"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "only the open todo remains",
          "expected": {
            "kind": "owned_count",
            "owned_tag": "{{run_id}}-clr",
            "count": 1
          }
