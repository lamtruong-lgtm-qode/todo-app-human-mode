              "by": "role",
              "role": "textbox",
              "name": "Edit title for Before {{run_id}}-edt"
            }
          }
        },
        {
          "kind": "action",
          "op": "fill",
          "intent": "type the new title",
          "target": {
            "by": "role",
            "role": "textbox",
            "name": "Edit title for Before {{run_id}}-edt"
          },
          "value": "After {{run_id}}-edt"
