          "capture": {
            "t": "$.title"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "server holds the new title",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "t",
            "value": "After {{run_id}}-edt"
          }
        }
      ],
      "teardown": [
        {
          "kind": "action",
          "op": "api",
          "intent": "clean up eid",
          "method": "DELETE",
          "api_path": "/api/todos/{{eid}}",
          "status": 204
        }
      ]
    },
