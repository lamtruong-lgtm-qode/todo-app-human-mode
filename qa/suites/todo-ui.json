        },
        {
          "kind": "action",
          "op": "api",
          "intent": "open todo survives",
          "method": "GET",
          "api_path": "/api/todos/{{oid}}",
          "status": 200,
          "capture": {
            "t": "$.title"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "open todo intact",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "t",
            "value": "Open {{run_id}}-clr"
          }
        }
      ],
      "teardown": [
        {
          "kind": "action",
          "op": "api",
          "intent": "clean up oid",
          "method": "DELETE",
          "api_path": "/api/todos/{{oid}}",
          "status": 204
        }
      ]
    },
    {
      "name": "AC-2: double-click title, edit, Enter saves",
      "tags": [
        "ac-2",
        "edit",
        "happy-path"
      ],
      "setup": [
        {
          "kind": "action",
          "op": "api",
          "intent": "seed 'Before {{run_id}}-edt'",
          "method": "POST",
          "api_path": "/api/todos",
          "body": {
            "title": "Before {{run_id}}-edt"
          },
          "status": 201,
          "capture": {
            "eid": "$.id"
          }
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open the todo app",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "seeded todo is listed",
          "expected": {
            "kind": "text_present",
            "text": "Before {{run_id}}-edt"
          }
        },
        {
          "kind": "action",
          "op": "double_click",
          "intent": "enter edit mode",
          "target": {
            "by": "text",
            "name": "Before {{run_id}}-edt"
          }
        },
        {
          "kind": "assert",
