          "capture": {
            "t1": "$"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "server holds the new title",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "t1",
            "value": "After {{run_id}}-ed"
          }
        }
      ]
    },
