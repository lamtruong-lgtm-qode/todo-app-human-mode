    {
      "name": "Add: button disabled when empty, row appears in Active, server holds it",
      "tags": [
        "add",
        "happy-path"
      ],
      "setup": [],
      "teardown": [
        {
          "kind": "action",
          "op": "api",
          "intent": "clean up aid",
          "method": "DELETE",
          "api_path": "/v1/todos/{{aid}}",
          "status": 204
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open the todos screen",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Add is disabled while the input is empty",
          "expected": {
            "kind": "disabled",
            "target": {
              "by": "testid",
              "name": "todos.addBtn"
            }
          }
        },
        {
          "kind": "action",
          "op": "fill",
          "intent": "type a run-tagged title",
          "target": {
            "by": "testid",
            "name": "todos.newTitle"
          },
          "value": "Add {{run_id}}-add"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Add is enabled once there is text",
          "expected": {
            "kind": "enabled",
            "target": {
              "by": "testid",
              "name": "todos.addBtn"
            }
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "submit the new todo",
          "target": {
            "by": "testid",
            "name": "todos.addBtn"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the new row appears",
          "expected": {
            "kind": "text_present",
            "text": "Add {{run_id}}-add"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "exactly one row of ours",
          "expected": {
            "kind": "owned_count",
            "owned_tag": "{{run_id}}-add",
            "count": 1
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the row has a Done button in Active",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "todos.toggleBtn",
              "nth": -1
            }
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "read back the server list",
          "method": "GET",
          "api_path": "/v1/todos?filter=all",
          "status": 200,
          "capture": {
            "all_todos": "$"
          }
        },
        {
          "kind": "action",
          "op": "transform",
          "intent": "find our persisted todo's id",
          "from_capture": "all_todos",
          "expr": "[.[] | select((.title | startswith(\"Add \")) and (.title | endswith(\"-add\"))) | .id][0] | tostring",
          "capture": {
            "aid": "$"
          }
        },
        {
          "kind": "action",
          "op": "transform",
          "intent": "count ours on the server",
          "from_capture": "all_todos",
          "expr": "[.[] | select((.title | startswith(\"Add \")) and (.title | endswith(\"-add\")))] | length",
          "capture": {
            "found": "$"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the server holds exactly one of ours",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "found",
            "value": "1"
          }
        }
      ]
    },
    {
      "name": "Done moves the row to the Done list, Undo moves it back",
      "tags": [
        "toggle"
      ],
      "setup": [
        {
          "kind": "action",
          "op": "api",
          "intent": "seed 'Flip {{run_id}}-dn'",
          "method": "POST",
          "api_path": "/v1/todos",
          "status": 201,
          "body": {
            "title": "Flip {{run_id}}-dn"
          },
          "capture": {
            "did": "$.id"
          }
        }
      ],
      "teardown": [
        {
          "kind": "action",
          "op": "api",
          "intent": "clean up did",
          "method": "DELETE",
          "api_path": "/v1/todos/{{did}}",
          "status": 204
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open the todos screen",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "our open todo is listed",
          "expected": {
            "kind": "text_present",
            "text": "Flip {{run_id}}-dn"
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "mark our (newest open) row Done",
          "target": {
            "by": "testid",
            "name": "todos.toggleBtn",
            "nth": -1
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "read the server list (after Done)",
          "method": "GET",
          "api_path": "/v1/todos?filter=all",
          "status": 200,
          "capture": {
            "all_d1": "$"
          }
        },
        {
          "kind": "action",
          "op": "transform",
          "intent": "pick done of our todo",
          "from_capture": "all_d1",
          "vars": {
            "i": "did"
          },
          "expr": "[.[] | select((.id | tostring) == ($i | tostring)) | .done][0] | tostring",
          "capture": {
            "d1": "$"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "server done is true",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "d1",
            "value": "true"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the Done list shows the Done badge",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "todos.doneBadge",
              "nth": 0
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the Done row offers Undo",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "todos.reopenBtn",
              "nth": 0
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "our todo is still shown",
          "expected": {
            "kind": "text_present",
            "text": "Flip {{run_id}}-dn"
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "Undo our row",
          "target": {
            "by": "testid",
            "name": "todos.reopenBtn",
            "nth": 0
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "read the server list (after Undo)",
          "method": "GET",
          "api_path": "/v1/todos?filter=all",
          "status": 200,
          "capture": {
            "all_d2": "$"
          }
        },
        {
          "kind": "action",
          "op": "transform",
          "intent": "pick done of our todo",
          "from_capture": "all_d2",
          "vars": {
            "i": "did"
          },
          "expr": "[.[] | select((.id | tostring) == ($i | tostring)) | .done][0] | tostring",
          "capture": {
            "d2": "$"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "server done is false again",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "d2",
            "value": "false"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the Done list has no Undo left",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "testid",
              "name": "todos.reopenBtn"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "the row offers Done again",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "todos.toggleBtn",
              "nth": -1
            }
          }
        }
      ]
    },
